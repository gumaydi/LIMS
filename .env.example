# Project URL dari Supabase Dashboard > Connect.
# Nilai VITE_SUPABASE_URL dan SUPABASE_URL harus sama.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Publishable key dari Supabase Dashboard > Settings > API Keys.
# Format hosted project: sb_publishable_...
# Key ini aman dipakai browser karena akses data tetap dibatasi RLS.
# Isi kedua variabel berikut dengan publishable key yang sama.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_GANTI_DENGAN_KEY_ANDA
SUPABASE_PUBLISHABLE_KEY=sb_publishable_GANTI_DENGAN_KEY_ANDA

# Secret key dari Supabase Dashboard > Settings > API Keys.
# Format hosted project: sb_secret_...
# Key ini hanya untuk Vercel Functions dan skrip operator. Jangan beri awalan VITE_.
SUPABASE_SECRET_KEY=sb_secret_GANTI_DENGAN_KEY_ANDA
